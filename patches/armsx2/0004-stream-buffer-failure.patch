+namespace
+{
+	std::atomic<bool> s_stream_failed{false};
+	std::atomic<GLStreamBuffer::FailureCallback> s_stream_failure_callback{nullptr};
+}
+
+void GLStreamBuffer::SetFailureCallback(FailureCallback callback)
+{
+	s_stream_failure_callback.store(callback, std::memory_order_release);
+	s_stream_failed.store(false, std::memory_order_release);
+}
+
+bool GLStreamBuffer::Failed()
+{
+	return s_stream_failed.load(std::memory_order_acquire);
+}
+
+bool GLStreamBuffer::Fail(u32 reason, u32 result)
+{
+	if (!s_stream_failed.exchange(true, std::memory_order_acq_rel))
+	{
+		if (const auto callback = s_stream_failure_callback.load(std::memory_order_acquire))
+			callback(reason, result);
+	}
+	return false;
+}
