+// psx adapter: expose the existing CPU-owner pause and file-card flush. Host
+// policy remains in Rust. Stop the GS handoff before a blocking CPU callback.
+extern "C" RETRO_API bool retro_psx_set_paused(bool paused)
+{
+	if (!LibretroCore::s_vm_thread_running.load(std::memory_order_acquire) || !VMManager::HasValidVM())
+		return false;
+#ifdef ENABLE_VULKAN
+	VKLibretro::SetPacing(false);
+#endif
+#ifdef ENABLE_OPENGL
+	GLLibretro::SetPacing(false);
+#endif
+	bool ok = false;
+	Host::RunOnCPUThread([paused, &ok]() {
+		if (!VMManager::HasValidVM())
+			return;
+		VMManager::SetState(paused ? VMState::Paused : VMState::Running);
+		ok = true;
+	}, true);
+#ifdef ENABLE_VULKAN
+	if (!paused && LibretroCore::s_context_ready.load(std::memory_order_acquire))
+		VKLibretro::SetPacing(true);
+#endif
+#ifdef ENABLE_OPENGL
+	if (!paused && GLLibretro::Active && LibretroCore::s_context_ready.load(std::memory_order_acquire))
+		GLLibretro::SetPacing(true);
+#endif
+	return ok;
+}
+
+extern "C" RETRO_API bool retro_psx_flush_cards(void)
+{
+	if (!LibretroCore::s_vm_thread_running.load(std::memory_order_acquire) || !VMManager::HasValidVM())
+		return false;
+	bool ok = false;
+	Host::RunOnCPUThread([&ok]() { ok = VMManager::HasValidVM() && FileMcd_Flush(); }, true);
+	return ok;
+}
+
+extern "C" RETRO_API bool retro_psx_ready(void)
+{
+	return LibretroCore::s_vm_thread_running.load(std::memory_order_acquire) && VMManager::HasValidVM();
+}
+
+extern "C" RETRO_API bool retro_psx_set_speed(float multiplier)
+{
+	if (!retro_psx_ready())
+		return false;
+	Host::RunOnCPUThread([multiplier]() {
+		{
+			auto lock = Host::GetSettingsLock();
+			s_base_settings->SetFloatValue("Framerate", "NominalScalar", multiplier);
+		}
+		VMManager::ApplySettings();
+	}, true);
+	return true;
+}
