+
+// Build-only call-site transport. Recording and failure policy live in Rust.
+namespace GSObservation
+{
+using Callback = u32 (*)(u32, u32, std::uintptr_t, u64, u64, u64, u64, u64);
+void SetCallback(Callback callback);
+u32 Result(u32 operation, u32 kind = 0, std::uintptr_t key = 0,
+    u64 a = 0, u64 b = 0, u64 c = 0, u64 d = 0, u64 e = 0);
+inline bool Unsafe() { return Result(15) != 0; }
+// Exactly one original destructive read. Its caller receives the same value.
+inline GLenum Error(u32 site, bool probe = false)
+{
+    const GLenum result = glGetError();
+    Result(2, 0, 0, result, site, probe ? 1 : 0);
+    return result;
+}
+struct Phase
+{
+    explicit Phase(u32 phase) { Result(0, 0, 0, phase); }
+    ~Phase() { Result(1); }
+};
+}
