 	void SetPacing(bool enabled);
diff --git a/pcsx2/GS/Renderers/Vulkan/VKLibretro.cpp b/pcsx2/GS/Renderers/Vulkan/VKLibretro.cpp
--- a/pcsx2/GS/Renderers/Vulkan/VKLibretro.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/VKLibretro.cpp
@@ -153,15 +153,19 @@
 	static Frame s_frame;
 	static u64 s_frame_serial = 0;
 	static u64 s_frame_consumed = 0;
+	static u64 s_frame_delivered = 0;
+	static void (*s_frame_ready_callback)() = nullptr;
 	static bool s_pacing = false;
 
 	void PublishFrame(const Frame& frame)
 	{
 		std::unique_lock<std::mutex> lock(s_frame_mutex);
 		s_frame = frame;
-		s_frame_serial++;
-		// Block the GS thread until retro_run picks the frame up (or pacing
-		// gets aborted for shutdown): one presented frame per retro_run.
+		s_frame.serial = ++s_frame_serial;
+		if (s_frame_ready_callback)
+			s_frame_ready_callback();
+		// Delivery is not completion: keep the image parked until the
+		// frontend has finished reading, or pacing is disabled for VM work.
 		s_frame_consumed_cv.wait(
 			lock, []() { return !s_pacing || s_frame_consumed == s_frame_serial; });
 	}
@@ -169,14 +173,32 @@
 	bool ConsumeFrame(Frame* out_frame)
 	{
 		std::lock_guard<std::mutex> lock(s_frame_mutex);
-		if (s_frame_serial == s_frame_consumed || s_frame.image == VK_NULL_HANDLE)
+		if (s_frame_serial == s_frame_delivered || s_frame.image == VK_NULL_HANDLE)
 			return false;
-		s_frame_consumed = s_frame_serial;
+		s_frame_delivered = s_frame_serial;
 		*out_frame = s_frame;
+		return true;
+	}
+
+	bool CompleteFrame(const Frame& frame)
+	{
+		std::lock_guard<std::mutex> lock(s_frame_mutex);
+		if (!frame.serial || frame.serial != s_frame_serial ||
+			frame.serial != s_frame_delivered || frame.serial == s_frame_consumed || frame.image != s_frame.image)
+			return false;
+		s_frame_consumed = frame.serial;
 		s_frame_consumed_cv.notify_all();
 		return true;
 	}
 
+	void SetFrameReadyCallback(void (*callback)())
+	{
+		std::lock_guard<std::mutex> lock(s_frame_mutex);
+		s_frame_ready_callback = callback;
+		if (callback && s_frame_serial != s_frame_delivered && s_frame.image != VK_NULL_HANDLE)
+			callback();
+	}
+
 	void SetPacing(bool enabled)
 	{
 		std::lock_guard<std::mutex> lock(s_frame_mutex);
@@ -198,6 +220,7 @@
 		s_frame = Frame();
 		s_frame_serial = 0;
 		s_frame_consumed = 0;
+		s_frame_delivered = 0;
 		s_pacing = false;
 		s_frame_consumed_cv.notify_all();
 	}
