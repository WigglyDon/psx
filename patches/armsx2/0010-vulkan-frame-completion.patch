@@ -70,10 +71,12 @@
 		u32 height = 0;
 	};
 	void PublishFrame(const Frame& frame);
-	bool ConsumeFrame(Frame* out_frame); // true if a new frame arrived since the last consume
+	bool ConsumeFrame(Frame* out_frame);
+	bool CompleteFrame(const Frame& frame);
